# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://predictora:predictora_dev@localhost:5432/predictora
POSTGRES_USER=predictora
POSTGRES_PASSWORD=predictora_dev
POSTGRES_DB=predictora

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=redisdev

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_strong_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_too_another_strong_random_secret

# ── External APIs ────────────────────────────────────────
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here
# Get free key at: https://www.football-data.org/client/register

# ── Firebase (for push notifications) ───────────────────
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# ── Email (optional) ─────────────────────────────────────
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@predictora.app
